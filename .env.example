# Visual underwriting HTTP service
VISUAL_UNDERWRITING_VISION_PROVIDER=mock
VISUAL_UNDERWRITING_ANTHROPIC_API_KEY=
VISUAL_UNDERWRITING_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
VISUAL_UNDERWRITING_ANTHROPIC_TIMEOUT_SECONDS=20
VISUAL_UNDERWRITING_ANTHROPIC_MAX_RETRIES=2

# Upload and business-rule settings
VISUAL_UNDERWRITING_MAX_IMAGE_BYTES=5242880
VISUAL_UNDERWRITING_GEOFENCE_RADIUS_METERS=500
VISUAL_UNDERWRITING_LOW_CONFIDENCE_THRESHOLD=0.65

# Duplicate-image detection. Use "memory" locally/tests or "redis" in production.
VISUAL_UNDERWRITING_IMAGE_HASH_STORAGE=memory
VISUAL_UNDERWRITING_REDIS_URL=redis://localhost:6379/0
VISUAL_UNDERWRITING_REDIS_KEY_PREFIX=visual-underwriting:image-hash

# Editable prompt files. Change these markdown files, then restart/redeploy.
VISUAL_UNDERWRITING_UNDERWRITING_PROMPT_PATH=visual_underwriting/prompts/underwriting_score.md
VISUAL_UNDERWRITING_ASSESSMENT_PROMPT_PATH=visual_underwriting/prompts/visual_assessment.md
